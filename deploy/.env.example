# ============================================================
# 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# .env 文件不应提交到版本控制
# ============================================================

# --- 数据库配置 ---
DB_URL=jdbc:mysql://localhost:3306/memory_garden?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# --- JWT 密钥（生产环境必须设置强随机密钥，至少32字符） ---
JWT_SECRET=your_jwt_secret_key_at_least_32_chars

# --- Swagger 开关（生产环境建议关闭） ---
SWAGGER_ENABLE=false

# --- 服务端口 ---
SERVER_PORT=8080
